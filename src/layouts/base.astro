---
import '../styles/global.css'
import ButtonTheme from '../components/button-theme.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href="/fonts/AS_lax_regular-webfont.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/AS_lax_bold-webfont.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/sanchez-regular-webfont.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      ;(() => {
        try {
          const theme = localStorage.getItem('theme')
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches
          const shouldUseDark = theme === 'dark' || (!theme && prefersDark)
          if (shouldUseDark) {
            document.documentElement.classList.add('dark')
          }
        } catch (e) {
          // use system pref
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark')
          }
        }
      })()
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          src="https://umami.roberto.page/script.js"
          data-website-id="85598c75-55b3-475b-ab20-dd1eb20e8ab0"
          data-do-not-track="true"
          data-cache="true"
        />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="description" content="roberto | web developer, vancouver" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>roberto | web developer</title>
  </head>

  <body class="mx-auto mb-20 flex min-h-full max-w-3xl flex-col px-6 py-12">
    <header class="sr-only">
      personal site
      <a rel="me" href="https://mastodon.social/@robhhr">Mastodon</a>
    </header>
    <main>
      <slot />
    </main>
  </body>

  <footer class="relative mt-auto py-4 text-sm">
    <ButtonTheme />

    <div class="flex gap-2">
      <a
        class="link"
        href="https://github.com/robhhr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="my github profile (opens in a new tab)"
      >
        github
      </a>
      •
      <a
        class="link"
        href="https://github.com/robhhr/site"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="this website's source code (opens in a new tab)"
      >
        source
      </a>
      •
      <a class="link" href="/privacy"> privacy policy </a>
    </div>
  </footer>
</html>
