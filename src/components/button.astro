---
const {title, url} = Astro.props
---

<div class="flex flex-col items-center">
  <a
    class="group relative inline-block cursor-pointer p-2 font-medium focus:outline-none"
    href={url}
    aria-label={`go to ${title}`}
  >
    <span
      aria-hidden="true"
      class="border-primary-light bg-primary-light group-hover:bg-primary-dark group-active:bg-primary-dark group-focus:bg-primary-dark absolute inset-0 h-full w-full translate-x-1 translate-y-1 transform border-2 border-dotted transition duration-200 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-focus:-translate-x-1 group-focus:-translate-y-1 group-active:-translate-x-1 group-active:-translate-y-1"
    ></span>
    <span
      aria-hidden="true"
      class="bg-primary-dark group-hover:bg-primary-light group-active:bg-primary-light group-focus:bg-primary-light border-primary-light absolute inset-0 h-full w-full border-2 border-dotted"
    ></span>
    <span
      aria-hidden="true"
      class="text-primary-light group-hover:text-primary-dark group-active:text-primary-dark group-focus:text-primary-dark relative"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 256 256"
        ><path
          d="M208,72H128V32a8,8,0,0,0-13.66-5.66l-96,96a8,8,0,0,0,0,11.32l96,96A8,8,0,0,0,128,224V184h80a16,16,0,0,0,16-16V88A16,16,0,0,0,208,72Zm0,96H120a8,8,0,0,0-8,8v28.69L35.31,128,112,51.31V80a8,8,0,0,0,8,8h88Z"
        ></path></svg
      >
    </span>
  </a>
</div>
