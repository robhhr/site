---
const {itemId, favorites = 0, type = 'thoughts'} = Astro.props
type Props = {
  itemId: string
  favorites: number
  type?: 'thoughts' | 'notes'
}
---

<div class="flex items-center gap-0.5">
  <button
    class="dark:text-primary-light text-primary-dark cursor-pointer transition-transform hover:scale-105"
    type="button"
    aria-label="like post"
    role="button"
    data-item-id={itemId}
    data-type={type}
    data-like-button
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      fill="currentColor"
      viewBox="0 0 256 256"
      aria-hidden="true"
      data-heart-icon
    >
      <!-- unfilled -->
      <path
        data-heart-unfilled
        d="M225.84,54.13A62.07,62.07,0,0,0,138.32,54L128,63.58,117.68,54a62,62,0,0,0-87.58,87.8l89.35,90.65a12,12,0,0,0,17.1,0l89.29-90.59a62,62,0,0,0,0-87.7Zm-17,70.79L128,206.9,47.13,124.85a38,38,0,0,1,53.74-53.74c.1.1.2.2.31.29l18.64,17.36a12,12,0,0,0,16.36,0L154.82,71.4c.11-.09.21-.19.31-.29a38,38,0,1,1,53.68,53.81Z"
      ></path>
      <!-- filled -->
      <path
        data-heart-filled
        d="M225.84,54.13A62.07,62.07,0,0,0,138.32,54L128,63.58,117.68,54a62,62,0,0,0-87.58,87.8l89.35,90.65a12,12,0,0,0,17.1,0l89.29-90.59a62,62,0,0,0,0-87.7Z"
        style="display: none;"></path>
    </svg>
  </button>
  <span class="text-xs" data-favorites-count>{favorites}</span>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const likeButtons = document.querySelectorAll(
      '[data-like-button]',
    ) as NodeListOf<HTMLButtonElement>

    likeButtons.forEach(button => {
      const itemId = button.getAttribute('data-item-id')
      const itemType = button.getAttribute('data-type')
      const unfilledHeart = button.querySelector(
        '[data-heart-unfilled]',
      ) as SVGPathElement
      const filledHeart = button.querySelector(
        '[data-heart-filled]',
      ) as SVGPathElement
      const favoritesSpan = button.parentElement?.querySelector(
        '[data-favorites-count]',
      ) as HTMLSpanElement

      if (!itemId || !itemType || !favoritesSpan || !unfilledHeart || !filledHeart) return

      const hasLiked = sessionStorage.getItem(`liked-${itemType}-${itemId}`)
      if (hasLiked) {
        unfilledHeart.style.display = 'none'
        filledHeart.style.display = 'block'
        button.setAttribute('aria-label', 'unlike post')
      }

      button.addEventListener('click', async e => {
        e.preventDefault()

        const isLiked = sessionStorage.getItem(`liked-${itemType}-${itemId}`)
        button.disabled = true

        try {
          const endpoint = isLiked ? 'unlike' : 'like'
          const response = await fetch(
            `/api/${itemType}/${itemId}/${endpoint}`,
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            },
          )

          if (response.ok) {
            const data = await response.json()
            favoritesSpan.textContent = data.favorites

            if (isLiked) {
              unfilledHeart.style.display = 'block'
              filledHeart.style.display = 'none'
              sessionStorage.removeItem(`liked-${itemType}-${itemId}`)
              button.setAttribute('aria-label', 'like post')
            } else {
              unfilledHeart.style.display = 'none'
              filledHeart.style.display = 'block'
              sessionStorage.setItem(`liked-${itemType}-${itemId}`, 'true')
              button.setAttribute('aria-label', 'unlike post')
            }

            button.style.transform = 'scale(1.2)'
            setTimeout(() => {
              button.style.transform = ''
            }, 150)
          } else {
            console.error(`failed to ${endpoint} post`)
          }
        } catch (error) {
          console.error(`error ${isLiked ? 'unliking' : 'liking'} post:`, error)
        } finally {
          button.disabled = false
        }
      })
    })
  })
</script>
