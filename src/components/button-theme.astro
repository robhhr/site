<button
  id="js-theme-toggle"
  class="group absolute -top-8 left-0 cursor-pointer rounded-full"
  type="button"
  aria-label="toggle theme"
  role="button"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    fill="currentColor"
    viewBox="0 0 256 256"
    aria-hidden="true"
  >
    <path
      id="melted-face"
      d="M176,140a12,12,0,1,1-12-12A12,12,0,0,1,176,140ZM128,92a12,12,0,1,0-12,12A12,12,0,0,0,128,92Zm73-38A104,104,0,0,0,50.48,197.33,8,8,0,1,0,62.4,186.66a88,88,0,1,1,131.19,0,8,8,0,0,0,11.93,10.67A104,104,0,0,0,201,54ZM152,168H136c-21.74,0-48-17.84-48-40a41.33,41.33,0,0,1,.55-6.68,8,8,0,1,0-15.78-2.64A56.9,56.9,0,0,0,72,128c0,14.88,7.46,29.13,21,40.15C105.4,178.22,121.07,184,136,184h16a8,8,0,0,1,0,16H96a24,24,0,0,0,0,48,8,8,0,0,0,0-16,8,8,0,0,1,0-16h56a24,24,0,0,0,0-48Z"
    ></path>
    <path
      id="smiling-face"
      d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM80,108a12,12,0,1,1,12,12A12,12,0,0,1,80,108Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,176,108Zm-1.07,48c-10.29,17.79-27.4,28-46.93,28s-36.63-10.2-46.92-28a8,8,0,1,1,13.84-8c7.47,12.91,19.21,20,33.08,20s25.61-7.1,33.07-20a8,8,0,0,1,13.86,8Z"
    ></path>
  </svg>
</button>

<script is:inline>
  const html = document.documentElement
  const toggleBtn = document.getElementById('js-theme-toggle')
  const meltedFace = document.getElementById('melted-face')
  const smilingFace = document.getElementById('smiling-face')

  const currentTheme = (() => {
    const stored = localStorage.getItem('theme')
    if (stored === 'dark' || stored === 'light') return stored
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light'
  })()

  const updateFaceIcon = theme => {
    if (theme === 'dark') {
      meltedFace.style.display = 'none'
      smilingFace.style.display = 'block'
    } else {
      meltedFace.style.display = 'block'
      smilingFace.style.display = 'none'
    }
  }

  const applyTheme = theme => {
    html.classList.toggle('dark', theme === 'dark')
    localStorage.setItem('theme', theme)
    updateFaceIcon(theme)
    toggleBtn.setAttribute(
      'aria-label',
      `switch to ${theme === 'dark' ? 'light' : 'dark'} theme`,
    )
  }

  applyTheme(currentTheme)

  toggleBtn?.addEventListener('click', () => {
    const isDark = html.classList.contains('dark')
    applyTheme(isDark ? 'light' : 'dark')
  })

  toggleBtn?.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      const isDark = html.classList.contains('dark')
      applyTheme(isDark ? 'light' : 'dark')
    }
  })
</script>
