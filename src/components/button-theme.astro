---

---

<button
  id="js-theme-toggle"
  class="group dark:border-primary-light dark:stroke-primary-dark dark:fill-primary-light border-primary-dark stroke-primary-light fill-primary-dark fixed top-1/2 right-1/2 -translate-1/2 cursor-pointer rounded-full border-2"
>
  <svg
    id="smiley"
    class="smiley h-7 w-7"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10" fill="currentColor"></circle>
    <path
      id="mouth"
      d="M8 14s1.5 2 4 2 4-2 4-2"
      data-smile="M8 14s1.5 2 4 2 4-2 4-2"
      data-flat="M8 14h8"
      stroke="stroke-current"></path>
    <line x1="9" x2="9.01" y1="9" y2="9" stroke="stroke-current"></line>
    <line x1="15" x2="15.01" y1="9" y2="9" stroke="stroke-current"></line>
  </svg>
</button>

<script is:inline>
  const html = document.documentElement
  const toggleBtn = document.getElementById('js-theme-toggle')
  const mouth = document.getElementById('mouth')
  const smilePath = mouth.dataset.smile
  const flatPath = mouth.dataset.flat

  const currentTheme = (() => {
    const stored = localStorage.getItem('theme')
    if (stored === 'dark' || stored === 'light') return stored
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light'
  })()

  const applyTheme = theme => {
    html.classList.toggle('dark', theme === 'dark')
    localStorage.setItem('theme', theme)
    mouth.setAttribute('d', theme === 'dark' ? smilePath : flatPath)
  }

  applyTheme(currentTheme)

  toggleBtn?.addEventListener('click', () => {
    const isDark = html.classList.contains('dark')
    applyTheme(isDark ? 'light' : 'dark')
  })

  toggleBtn.addEventListener('mouseenter', () => {
    const currentPath = mouth.getAttribute('d')
    mouth.setAttribute('d', currentPath === smilePath ? flatPath : smilePath)
  })

  toggleBtn.addEventListener('mouseleave', () => {
    const isDark = html.classList.contains('dark')
    mouth.setAttribute('d', isDark ? smilePath : flatPath)
  })
</script>
