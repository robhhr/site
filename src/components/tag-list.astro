---
const {tags} = Astro.props
type Props = {tags: string[]}
---

{
  tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span
          class="text-primary-light text-xs font-bold"
          aria-label={`tag: ${t}`}
        >
          #{t}
        </span>
      ))}
    </div>
  )
}
