---
import Button from './button.astro'
const {title, url} = Astro.props
---

<div class="mb-10">
  {
    title && (
      <div class="relative flex items-center">
        <div class="-ml-14">
          <Button title="home" url={url} />
        </div>

        <h1 class="ml-5">{title}</h1>
      </div>
    )
  }
</div>
