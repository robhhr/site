---
import Button from './button.astro'
const {title, url} = Astro.props
---

<div class="mb-10">
  {
    title && (
      <div class="relative flex flex-col justify-start lg:flex-row lg:items-center">
        <div class="mb-4 w-fit lg:mb-0 lg:-ml-20">
          <Button title="home" url={url} />
        </div>

        <h1 class="lg:ml-11">{title}</h1>
      </div>
    )
  }
</div>
