---
const {items, title} = Astro.props
import Thought from './thought.astro'
import type {ThoughtType} from '../../types/thought.types'
---

<div>
  {title && <h2 class="mb-5">{title}</h2>}
  <ul class="flex flex-col gap-6">
    {items.map((item: ThoughtType) => <Thought thought={item} />)}
  </ul>
</div>
