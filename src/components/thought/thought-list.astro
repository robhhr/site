---
const {items, title, isFullPage = false} = Astro.props
import Thought from './thought.astro'
import type {ThoughtType} from '../../types/thought.types'
---

<div>
  {
    title && (
      <div class="flex items-baseline">
        <h2 class="section-title">{title}</h2>
        <span class="ml-2 flex text-xs">
          (
          <a class="link" href="/thoughts" aria-label="read all thoughts">
            read all
          </a>
          )
        </span>
      </div>
    )
  }

  <ul class=`${isFullPage ? '-mt-10' : ''} flex flex-col`>
    {
      items.map((item: ThoughtType) => (
        <li
          class={
            isFullPage
              ? 'border-link-dark border-b-2 border-dotted py-12 last:border-b-0'
              : null
          }
        >
          <Thought thought={item} />
        </li>
      ))
    }
  </ul>
</div>
