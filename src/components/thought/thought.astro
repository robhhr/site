---
import type {ThoughtType} from '../../types/thought.types'
import {getDate} from '../../utils/get-date'
import MarkdownRenderer from '../markdown-renderer'
import ButtonHeart from '../button-heart.astro'

const {thought} = Astro.props
type Props = {thought: ThoughtType}
console.log('thought:', thought)
---

<article
  class="dark:border-primary-light/50 border-primary-dark/50 flex max-w-none flex-col border-b py-4"
>
  <MarkdownRenderer content={thought.content} />
  <div class="mt-2 flex justify-between items-center">
    {
      thought.tags && thought.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {thought.tags.map(tag => (
            <span
              class="dark:text-primary-light text-primary-dark text-xs"
              aria-label={`tag: ${tag}`}
            >
              #{tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="flex items-center ml-auto">
      <p class="dark:text-primary-light/50 text-primary-dark/50 text-xs">
        {getDate(thought.created_at)}
      </p>
      <span class="mx-1"> • </span>
      <ButtonHeart
        thoughtId={String(thought.id)}
        favorites={thought.favorites}
      />
    </div>
  </div>
</article>
