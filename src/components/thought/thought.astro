---
import type {ThoughtType} from '../../types/thought.types'
import {getDate} from '../../utils/get-date'
import MarkdownRenderer from '../markdown-renderer'
import ButtonHeart from '../button-heart.astro'
import Pinned from '../pinned.astro'
import TagList from '../tag-list.astro'

const {thought} = Astro.props
type Props = {thought: ThoughtType}
---

<article
  class="dark:border-primary-light/25 border-primary-dark/25 relative flex max-w-none flex-col border-b-[0.5px] py-8 first-of-type:pt-0 last-of-type:border-b-0 last-of-type:pb-0"
>
  {thought.is_pinned && <Pinned />}
  <MarkdownRenderer content={thought.content} />
  <div class="mt-2 flex items-center justify-between">
    <TagList tags={thought.tags} />

    <div class="ml-auto flex items-center">
      <p class="dark:text-primary-light/50 text-primary-dark/50 text-xs">
        {getDate(thought.created_at)}
      </p>
      <span class="mx-1"> • </span>
      <ButtonHeart
        thoughtId={String(thought.id)}
        favorites={thought.favorites}
      />
    </div>
  </div>
</article>
