---
import {tryCatch} from '../utils/try-catch'
import {getNotes} from '../db/models/notes'
import {getProjects} from '../db/models/projects'
import {getThoughts} from '../db/models/thoughts'
import BaseLayout from '../layouts/base.astro'
import List from '../components/list.astro'
import ThoughtList from '../components/thought/thought-list.astro'

const [noteData, projectData, thoughtData] = await Promise.all([
  tryCatch(getNotes({limit: 3})),
  tryCatch(getProjects({limit: 3})),
  tryCatch(getThoughts({limit: 3})),
])

const entries = {
  notes: noteData,
  project: projectData,
  thought: thoughtData,
}

for (const [key, value] of Object.entries(entries)) {
  if (value.error) {
    console.log(`${key} error:`, value.error)
  }
}
---

<BaseLayout>
  <div class="flex flex-col gap-4 p-4">
    <div class="flex flex-col">
      <p class="mt-4 mb-2">coming soon</p>
    </div>
  </div>
</BaseLayout>
