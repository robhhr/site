---
import {tryCatch} from '../utils/try-catch'
import {getNotes} from '../db/models/notes'
import {getProjects} from '../db/models/projects'
import {getThoughts} from '../db/models/thoughts'
import BaseLayout from '../layouts/base.astro'
import Projects from '../components/home/projects.astro'
import Thoughts from '../components/home/thoughts.astro'
import Notes from '../components/home/notes.astro'
import Logo from '../assets/logo-alt.svg?raw'

const [noteData, projectData, thoughtData] = await Promise.all([
  tryCatch(getNotes({limit: 3})),
  tryCatch(getProjects({limit: 3})),
  tryCatch(getThoughts({limit: 3})),
])

const entries = {
  notes: noteData,
  project: projectData,
  thought: thoughtData,
}

for (const [key, value] of Object.entries(entries)) {
  if (value.error) {
    console.log(`${key} error:`, value.error)
  }
}
---

<BaseLayout>
  <div class="flex flex-col gap-4 p-4">
    <div set:html={Logo} class="h-20 w-20" />

    <h1 class="mt-4 mb-10">title here</h1>

    {projectData.data?.length > 0 && <Projects projects={projectData.data} />}
    {thoughtData.data?.length > 0 && <Thoughts thoughts={thoughtData.data} />}
    {noteData.data?.length > 0 && <Notes notes={noteData.data ?? []} />}
  </div>
</BaseLayout>
