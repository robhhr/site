---
import {getNoteBySlug} from '../../db/models/notes'
import {getDate} from '../../utils/get-date'
import BaseLayout from '../../layouts/base.astro'
import Button from '../../components/button.astro'
import ButtonHeart from '../../components/button-heart.astro'
import MarkdownRenderer from '../../components/markdown-renderer'
import ProgressBar from '../../components/progress.astro'
import TagList from '../../components/tag-list.astro'
import type {NoteType} from '../../types/note.types'

const slug = Astro.params.slug
const note = await getNoteBySlug(slug)

if (!note) {
  throw new Error(`note ${slug} not found`)
}

type Props = {note: NoteType}
---

<BaseLayout>
  <ProgressBar />
  <div class="flex items-center">
    <div class="-ml-14">
      <Button title="home" url="/" />
    </div>
    <h1 class="ml-5">{note.title}</h1>
  </div>

  <div class="mt-2 mb-10 flex flex-col gap-2">
    <p class="dark:text-primary-light/50 text-primary-dark/50 text-xs">
      {getDate(note.created_at)}
    </p>
    <TagList tags={note.tags} />
  </div>

  <div class="mb-32">
    <MarkdownRenderer content={note.content} />

    <div class="mt-10 flex items-center justify-between">
      <ButtonHeart itemId={note.id} favorites={note.favorites} type="notes" />
    </div>
  </div>
</BaseLayout>
