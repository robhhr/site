---
import {getNoteBySlug} from '../../db/models/notes'
import type {NoteType} from '../../types/note.types'
import SingleLayout from '../../layouts/single.astro'
import ButtonHeart from '../../components/button-heart.astro'
import MarkdownRenderer from '../../components/markdown-renderer'

const slug = Astro.params.slug
const note = await getNoteBySlug(slug)

if (!note) {
  throw new Error(`note ${slug} not found`)
}

type Props = {note: NoteType}
---

<SingleLayout item={note}>
  <MarkdownRenderer content={note.content} />
  <div class="mt-10 flex items-center justify-between">
    <ButtonHeart itemId={note.id} favorites={note.favorites} type="notes" />
  </div>
</SingleLayout>
