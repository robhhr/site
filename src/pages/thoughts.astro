---
import {tryCatch} from '../utils/try-catch'
import {getThoughts} from '../db/models/thoughts'
import PageLayout from '../layouts/page.astro'
import ThoughtList from '../components/thought/thought-list.astro'

const thoughts = await tryCatch(getThoughts({limit: 5}))

if (thoughts.error) {
  console.error('Error fetching thoughts:', thoughts.error)
}
---

<PageLayout title="thoughts" url="/">
  <ThoughtList items={thoughts.data || []} />
</PageLayout>
